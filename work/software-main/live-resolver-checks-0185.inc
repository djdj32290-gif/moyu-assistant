check('Huya aliases remain deferred candidates and cannot be stored without a numeric identity',()=>{assert.equal(D.candidate('https://www.huya.com/lpl').kind,'live-pending');assert.throws(()=>D.queueItem(D.candidate('https://www.huya.com/lpl')));for(const url of ['garbage','https://www.huya.com/g/lol','https://live.bilibili.com/1'])assert.throws(()=>D.candidate(url));});
check('Platform filters classify records without changing the canonical queue',()=>{assert.equal(D.group(D.item({url:'https://www.huya.com/660000'})),'huya');assert.equal(D.group(D.item({url:'https://www.bilibili.com/video/BV1GJ411x7h7'})),'bilibili');assert.equal(D.group(D.item({kind:'media',mediaUrl:'https://example.org/a.mp4'})),'other');});
check('Image hover preference is schema-1 compatible and rejects malformed values before import',()=>{const data={[D.previewKey]:{images:false}},parsed=B.parse(JSON.stringify(B.create(data)));assert.equal(parsed[D.previewKey].images,false);assert.equal(B.owns(D.previewKey),true);for(const value of [{images:0},{images:false,extra:true},{}])assert.throws(()=>B.validate({[D.previewKey]:value}));const writes=B.merge(data,{[D.key]:[]});assert(!Object.hasOwn(writes,D.previewKey));});
const decoder=globalThis.TextDecoder;Object.assign(context,{AbortSignal,TextDecoder:decoder,chrome:{runtime:{onMessage:{addListener(){}}}},console});vm.runInContext(fs.readFileSync(path.join(root,'src/video-background.js'),'utf8'),context);
async function resolverCheck(name,fn){await fn();checks.push({name});console.log('PASS',name);}
function response(html,url='https://www.huya.com/lpl'){const bytes=new TextEncoder().encode(html);let read=false;return {ok:true,url,body:{getReader(){return {async read(){if(read)return {done:true};read=true;return {done:false,value:bytes};},async cancel(){}};}}};}
await resolverCheck('Public alias resolution reads only standard same-origin canonical metadata and omits credentials',async()=>{let options;context.fetch=async(url,args)=>{assert.equal(url,'https://www.huya.com/lpl');options=args;return response(`<link data-x="1" href='https://www.huya.com/660000' REL='canonical'>`);};const item=await context.resolveVideoLink('https://www.huya.com/lpl');assert.equal(item.id,'huya-live:660000');assert.equal(options.credentials,'omit');});
await resolverCheck('Room resolver rejects foreign canonical links, unresolved rooms and oversized public pages',async()=>{for(const html of [`<link rel="canonical" href="https://evil.example/660000">`,'<html>no room</html>']){context.fetch=async()=>response(html);await assert.rejects(()=>context.resolveVideoLink('https://www.huya.com/lpl'));}context.fetch=async()=>response('x'.repeat(4*1024*1024+1));await assert.rejects(()=>context.resolveVideoLink('https://www.huya.com/lpl'));});
